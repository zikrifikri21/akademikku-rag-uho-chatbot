# --- LLM (Groq) ---
GROQ_API_KEY=
DEFAULT_GROQ_MODEL=openai/gpt-oss-20b
# Model yang boleh dikirim di field "model" (pisahkan dengan koma); selain ini dipakai model default
ALLOWED_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b

# --- Index hasil notebook v3 (salin folder chroma_db_akademik dari Colab/Drive ke server) ---
CHROMA_DIR=./chroma_db_akademik
CHROMA_COLLECTION=akademik_uho
# Harus SAMA dengan notebook. Beda model = pencarian tidak cocok / error dimensi.
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Kosong = otomatis (cuda kalau ada)
DEVICE=

# --- Retrieval (nilai notebook) ---
FETCH_K=15
# Notebook memakai 30. Reranker di CPU lambat: turunkan kalau latensi tinggi.
RERANK_CANDIDATES=20
TOP_N=5
# Di bawah skor ini = "tidak ditemukan". Kalibrasi di sel evaluasi notebook, lihat log "[rag_engine] ... skor tertinggi".
MIN_RERANK_SCORE=0.2

# --- Keamanan ---
# Shared secret Laravel <-> FastAPI. WAJIB diisi di production.
INTERNAL_API_KEY=
CORS_ORIGINS=http://localhost,http://localhost:8000
