# API key Groq (sama dengan yang dipakai di notebook Colab)
GROQ_API_KEY=

# API key Tavily untuk web search live fallback (kosongkan untuk menonaktifkan fitur ini)
TAVILY_API_KEY=

# Folder ChromaDB hasil embedding dari notebook Colab (copy folder chroma_db_uho ke server ini)
CHROMA_DIR=./chroma_db_uho
CHROMA_COLLECTION=uho_knowledge_base

# Harus SAMA PERSIS dengan model embedding yang dipakai saat membangun vector store di notebook
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Dipakai kalau frontend tidak mengirim field "model" secara eksplisit
DEFAULT_GROQ_MODEL=openai/gpt-oss-20b

# Ambang skor cosine similarity vector store sebelum fallback ke web search (0-1).
# Model embedding MiniLM cenderung memberi skor 0.3-0.5 bahkan untuk dokumen yang relevan,
# jadi mulai dari 0.35 lalu naikkan/turunkan sambil lihat log "[rag_engine] Skor cosine..."
# di konsol server untuk kalibrasi berdasarkan pertanyaan nyata.
AMBANG_SKOR_RELEVANSI=0.35

# Jumlah chunk yang diambil per pencarian
RETRIEVAL_K=8

# Shared secret opsional antara Laravel <-> FastAPI (kosongkan untuk menonaktifkan saat development)
INTERNAL_API_KEY=

# Origin yang boleh mengakses (pisahkan dengan koma kalau lebih dari satu)
CORS_ORIGINS=http://localhost,http://localhost:8000
