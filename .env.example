# --- Web Application (Laravel 12 + React 19 Inertia) ---
APP_NAME="Akademikku RAG UHO"
APP_ENV=production
APP_DEBUG=false
# URL publik (dilayani Traefik, sertifikat Let's Encrypt)
APP_URL=https://akademik-uho.inovasitech.com
FORCE_HTTPS=true
# php artisan key:generate --show
APP_KEY=base64:...

# --- RAG API (uho_rag_api v2) ---
GROQ_API_KEY=gsk_
DEFAULT_GROQ_MODEL=openai/gpt-oss-20b
ALLOWED_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b
# kunci acak: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

# --- Index ChromaDB ---
# Letakkan folder hasil notebook di ./uho_rag_api/chroma_db_akademik/
# Nama koleksi & model embedding harus SAMA dengan yang dipakai notebook saat membuat index.
CHROMA_COLLECTION=akademik_uho
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# Batas RAM container RAG (bge-m3 + reranker di CPU butuh ~5-6 GB)
RAG_MEM_LIMIT=6g
