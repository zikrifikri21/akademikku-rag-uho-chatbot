# ===============================================
# KONFIGURASI DOCKER ENVIRONMENT MONOREPO
# ===============================================

# --- General Web Configuration ---
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=base64:GENERATE_YOUR_OWN_LARAVEL_KEY_HERE

# --- API Keys untuk Python Microservice (uho_rag_api) ---
# Minimal salah satu LLM Provider API Key terisi (Groq recommended / default)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Tavily Live Web Search API Key (fallback web search jika vector store kurang lengkap)
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# --- RAG API Parameters ---
INTERNAL_API_KEY=secret_rag_key_123
AMBANG_SKOR_RELEVANSI=0.35
RETRIEVAL_K=8
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
DEFAULT_GROQ_MODEL=openai/gpt-oss-20b
